module attributes {
  "ttg.num-ctas" = 1 : i32,
  "ttg.num-warps" = 4 : i32,
  "ttg.target" = "cuda:103",
  "ttg.threads-per-warp" = 32 : i32
} {
  tt.func public @ws_skeleton(%out: !tt.ptr<i32> {tt.divisibility = 16 : i32}) {
    %default_value = arith.constant 7 : i32
    %worker_value = arith.constant 11 : i32
    %one = arith.constant 1 : i32
    %worker_ptr = tt.addptr %out, %one : !tt.ptr<i32>, i32
    tt.store %out, %default_value : !tt.ptr<i32>
    tt.store %worker_ptr, %worker_value : !tt.ptr<i32>
    tt.return
  }
}
