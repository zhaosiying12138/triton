module attributes {
  "ttg.num-ctas" = 1 : i32,
  "ttg.num-warps" = 4 : i32,
  "ttg.target" = "cuda:103",
  "ttg.threads-per-warp" = 32 : i32
} {
  tt.func public @ws_skeleton(%out: !tt.ptr<i32> {tt.divisibility = 16 : i32}) {
    %default_value = arith.constant 7 : i32
    ttg.warp_specialize(%out) attributes {requestedRegisters = array<i32: 24>}
    default {
      tt.store %out, %default_value : !tt.ptr<i32>
      ttg.warp_yield
    }
    partition0(%worker_out: !tt.ptr<i32>) num_warps(1) {
      %worker_value = arith.constant 11 : i32
      %one = arith.constant 1 : i32
      %worker_ptr = tt.addptr %worker_out, %one : !tt.ptr<i32>, i32
      tt.store %worker_ptr, %worker_value : !tt.ptr<i32>
      ttg.warp_return
    } : (!tt.ptr<i32>) -> ()
    tt.return
  }
}
